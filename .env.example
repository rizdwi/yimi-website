# Konfigurasi Supabase untuk Website YIMI
# Salin ke .env.local dan isi dengan nilai asli dari dashboard Supabase.
# JANGAN commit file .env.local (sudah di-gitignore).
# JANGAN taruh service_role key di sini — hanya anon key (public).

NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi_dengan_anon_key_dari_dashboard_supabase

# Rahasia server (JANGAN pakai prefix NEXT_PUBLIC_ — hanya di server):
# ADMIN_JWT_SECRET=isi_dengan_string_acak_min_32_karakter
